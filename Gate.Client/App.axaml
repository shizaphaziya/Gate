<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="Gate.Client.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />

        <Style Selector="Button, ComboBox, CheckBox">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:disabled, ComboBox:disabled, CheckBox:disabled">
            <Setter Property="Cursor" Value="No" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource GateTextPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="materialIcons|MaterialIcon">
            <Setter Property="(AutomationProperties.AccessibilityView)" Value="Raw" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Inter ships with the app: full Cyrillic coverage and legible at the 11px used in dense tables. -->
        <SolidColorBrush x:Key="GateBgApp">#121316</SolidColorBrush>
        <SolidColorBrush x:Key="GateBgHeader">#1B1C22</SolidColorBrush>
        <SolidColorBrush x:Key="GateBgCard">#1B1C22</SolidColorBrush>
        <SolidColorBrush x:Key="GateBgCardSecondary">#22242D</SolidColorBrush>
        <SolidColorBrush x:Key="GateBgInput">#22242D</SolidColorBrush>
        <SolidColorBrush x:Key="GateBorderBrush">#2B2D3A</SolidColorBrush>
        <SolidColorBrush x:Key="GateTextPrimary">#F3F4F6</SolidColorBrush>
        <SolidColorBrush x:Key="GateTextSecondary">#9CA3AF</SolidColorBrush>
        <SolidColorBrush x:Key="GateTextTertiary">#8B93A1</SolidColorBrush>
        <SolidColorBrush x:Key="GateAccent">#2563EB</SolidColorBrush>
        <SolidColorBrush x:Key="GateAccentFg">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="GateBadgeBg">#262833</SolidColorBrush>
        <SolidColorBrush x:Key="GateButtonNeutralBg">#374151</SolidColorBrush>
        <SolidColorBrush x:Key="GateAuditLogBg">#1B1C22</SolidColorBrush>
        <SolidColorBrush x:Key="GateAuditRowBg">#22242D</SolidColorBrush>
        <SolidColorBrush x:Key="GateAuditHeaderBg">#121316</SolidColorBrush>
        <SolidColorBrush x:Key="GateTerminalBg">#0D1117</SolidColorBrush>
        <SolidColorBrush x:Key="GateTerminalFg">#58A6FF</SolidColorBrush>
        <SolidColorBrush x:Key="GateTerminalLogsFg">#C9D1D9</SolidColorBrush>
        <SolidColorBrush x:Key="GateSelectionBg">#1E293B</SolidColorBrush>
        <SolidColorBrush x:Key="GateSuccess">#047857</SolidColorBrush>
        <SolidColorBrush x:Key="GateDanger">#B91C1C</SolidColorBrush>
        <SolidColorBrush x:Key="GateWarning">#B45309</SolidColorBrush>
        <SolidColorBrush x:Key="GateDangerText">#F87171</SolidColorBrush>
    </Application.Resources>
</Application>
